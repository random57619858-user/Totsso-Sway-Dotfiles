{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "artix_small",
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        },
        "color": {
            "1": "magenta",
            "2": "blue",
            "3": "cyan"
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "green"
        },
        "key": {
            "width": 14
        }
    },
    "modules": [
        {
            "type": "title",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "\u001b[90m────────────────────\u001b[0m"
        },
        "os",
        "kernel",
        "uptime",
        "packages",
        "break",
        "wm",
        "theme",
        "icons",
        {
            "type": "custom",
            "key": "Terminal",
            "format": "kitty"
        },
        "shell",
        "break",
        "cpu",
        "gpu",
        "memory",
        "disk",
        {
            "type": "localip",
            "showPrefixLen": false
        },
        "break",
        "colors"
    ]
}
